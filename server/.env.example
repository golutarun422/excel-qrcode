# Local Server Configuration
PORT=3001
HOST=0.0.0.0

# Dedicated storage path on Windows laptop (e.g. C:\ExcelQRStorage\files)
STORAGE_DIR=C:\ExcelQRStorage\files
DATABASE_PATH=C:\ExcelQRStorage\excel_qr.db

# File limits (50MB = 52428800 bytes)
MAX_FILE_SIZE_BYTES=52428800

# Optional: Set an Admin API Key if you want to require authorization for uploads
# If blank, public uploads are accepted within rate limits
ADMIN_API_KEY=
