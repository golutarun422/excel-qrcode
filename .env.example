# Backend API URL (Local Server or Cloudflare Tunnel HTTPS URL)
# In local development: http://localhost:3001
# In production with Vercel: https://your-tunnel.trycloudflare.com (or your custom domain)
VITE_API_BASE_URL=http://localhost:3001

# Public Frontend Application URL (Used to encode stable QR code links)
# Leave empty to automatically use current domain (window.location.origin)
# Example for production: https://excel-qr.vercel.app
VITE_PUBLIC_APP_URL=

# Optional: Admin API Key (if ADMIN_API_KEY is configured on the backend)
VITE_ADMIN_API_KEY=
